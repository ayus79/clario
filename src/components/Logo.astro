---
interface Props { class?: string; light?: boolean }
const { class: cls = '', light = false } = Astro.props;
---
<span class:list={['logo', cls, { light }]} aria-label="Clario">
  <svg viewBox="0 0 64 64" width="30" height="30" aria-hidden="true">
    <rect width="64" height="64" rx="16" class="bg" />
    <path d="M42 22.5a14 14 0 1 0 0 19" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" class="ring" />
    <circle cx="46" cy="32" r="4.5" fill="#4fb28f" />
  </svg>
  <span class="word">clario</span>
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); }
  .bg { fill: var(--ink); }
  .ring { color: var(--paper); }
  .word { font-family: var(--font-display); font-size: 1.5rem; font-weight: 500; letter-spacing: -0.03em; line-height: 1; }
  .light { color: var(--ink-inverse); }
  .light .bg { fill: var(--ink-inverse); }
  .light .ring { color: var(--ink); }
</style>
