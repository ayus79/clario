---
const items = [
  { t: 'Credentials encrypted at rest', d: 'OAuth tokens and integration secrets are stored encrypted and transmitted securely.', i: 'lock' },
  { t: 'Your data stays yours', d: 'Communication data is isolated per user. You only ever see your own accounts and messages.', i: 'user' },
  { t: 'No training without consent', d: 'Your messages aren’t used to train models without your explicit consent and appropriate controls.', i: 'shield' },
  { t: 'Never silently lose a message', d: 'Retries, checkpoints and idempotent sync mean a failed connection is surfaced, not swallowed.', i: 'sync' },
  { t: 'Clear about what we process', d: 'We explain what’s synced and why, with defined retention and deletion policies.', i: 'eye' },
  { t: 'Auditable actions', d: 'User and agent actions are logged, so unexpected behaviour can always be investigated.', i: 'list' },
];
const icons: Record<string, string> = {
  lock: '<rect x="4" y="10" width="16" height="10" rx="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>',
  user: '<circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 4-6 8-6s8 2 8 6"/>',
  shield: '<path d="M12 3 5 6v6c0 4.5 3 7.5 7 9 4-1.500 7-4.500 7-9V6z"/><path d="m9 12 2 2 4-4"/>',
  sync: '<path d="M20 8a8 8 0 0 0-14-2M4 4v4h4M4 16a8 8 0 0 0 14 2M20 20v-4h-4"/>',
  eye: '<path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>',
  list: '<path d="M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01"/>',
};
---
<section class="section security" id="security">
  <div class="wrap">
    <div class="section-head center reveal">
      <p class="eyebrow">Security &amp; privacy</p>
      <h2 class="h2">Your inbox is personal. <em>We treat it that way.</em></h2>
      <p class="lede">An assistant that reads your messages has to earn that access. These are the commitments we build around.</p>
    </div>
    <div class="grid">
      {items.map((x, i) => (
        <article class="it reveal" style={`transition-delay:${(i % 3) * 70}ms`}>
          <span class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[x.i]} /></span>
          <h3>{x.t}</h3>
          <p>{x.d}</p>
        </article>
      ))}
    </div>
  </div>
</section>
<style>
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .it { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 26px; display: grid; gap: 10px; align-content: start; }
  .ic { width: 44px; height: 44px; border-radius: 12px; background: var(--calm-tint); color: var(--calm); display: grid; place-items: center; margin-bottom: 6px; }
  h3 { font-weight: 650; font-size: 1.04rem; letter-spacing: -.005em; }
  p { color: var(--ink-2); font-size: .96rem; }
  @media (max-width: 960px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 580px) { .grid { grid-template-columns: 1fr; } }
</style>
