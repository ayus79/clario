---
// Deterministic "noise field": most bars are neutral; three carry signal.
const total = 84;
const signal: Record<number, string> = { 17: 'urgent', 46: 'blocker', 69: 'follow' };
const widths = [62, 84, 48, 76, 91, 55, 68, 80];
const bars = Array.from({ length: total }, (_, i) => ({ i, kind: signal[i] ?? 'noise', w: widths[(i * 5) % widths.length] }));
const costs = [
  { t: 'Missed opportunities', d: 'A warm inbound lead sits unread for a week and quietly goes cold.' },
  { t: 'Blocked teammates', d: 'Someone finished their work and is waiting on one approval only you can give.' },
  { t: 'Dropped follow-ups', d: 'You said “I’ll send it Monday.” Monday was buried by Tuesday.' },
];
---
<section class="section problem" id="problem">
  <div class="wrap grid">
    <div class="copy reveal">
      <p class="eyebrow">The problem</p>
      <h2 class="h2">The message that mattered is buried under all the ones that didn’t.</h2>
      <p class="lede">
        Professionals now live across four or five inboxes. Important decisions, follow-ups and team blockers
        scroll past at the same size and volume as newsletters and notifications.
      </p>
      <ul class="costs">
        {costs.map((c) => (<li><strong>{c.t}</strong><span>{c.d}</span></li>))}
      </ul>
    </div>
    <div class="field reveal" aria-hidden="true">
      <div class="bars">
        {bars.map((b) => (<i class={`b ${b.kind}`} style={`--w:${b.w}%`}></i>))}
      </div>
      <p class="legend"><span><i class="k urgent"></i>needs a decision</span><span><i class="k blocker"></i>someone is waiting</span><span><i class="k follow"></i>needs a reply</span></p>
    </div>
  </div>
</section>
<style>
  .grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(32px, 6vw, 88px); align-items: center; }
  .copy { display: grid; gap: 22px; }
  .costs { display: grid; gap: 0; margin-top: 8px; }
  .costs li { display: grid; gap: 2px; padding: 16px 0; border-top: 1px solid var(--line); }
  .costs li:last-child { border-bottom: 1px solid var(--line); }
  .costs strong { font-weight: 650; font-size: 1rem; }
  .costs span { color: var(--ink-2); font-size: .98rem; }
  .field { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 28px; box-shadow: var(--shadow-2); }
  .bars { display: grid; grid-template-columns: repeat(4, 1fr); gap: 9px 12px; }
  .b { display: block; height: 10px; border-radius: 99px; background: var(--paper-2); width: var(--w); }
  .b.urgent, .b.blocker, .b.follow { width: 100%; height: 14px; position: relative; box-shadow: 0 0 0 5px color-mix(in srgb, currentColor 14%, transparent); }
  .b.urgent { background: var(--urgent); color: var(--urgent); }
  .b.blocker { background: var(--blocker); color: var(--blocker); }
  .b.follow { background: var(--follow); color: var(--follow); }
  .legend { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 24px; padding-top: 18px; border-top: 1px dashed var(--line-strong); font-size: .82rem; color: var(--ink-2); font-weight: 500; }
  .legend span { display: inline-flex; align-items: center; gap: 8px; }
  .k { width: 9px; height: 9px; border-radius: 50%; display: inline-block; }
  .k.urgent { background: var(--urgent); } .k.blocker { background: var(--blocker); } .k.follow { background: var(--follow); }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } }
</style>
